<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Point CPython MSBuild directly to our freshly compiled OpenSSL installation -->
    <opensslDir Condition="$(OpenSSLInstallDir) != ''">$(OpenSSLInstallDir)\</opensslDir>
    <opensslIncludeDir Condition="$(OpenSSLInstallDir) != ''">$(OpenSSLInstallDir)\include</opensslIncludeDir>
    <opensslOutDir Condition="$(OpenSSLInstallDir) != ''">$(OpenSSLInstallDir)\lib</opensslOutDir>
    <!-- Skip copying runtime DLLs for static (no-shared) OpenSSL builds -->
    <SkipCopySSLDLL Condition="$(SkipCopySSLDLL) == ''">true</SkipCopySSLDLL>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories Condition="'$(ProjectName)' == '_ssl' or '$(ProjectName)' == '_hashlib'">$(opensslIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories Condition="'$(ProjectName)' == '_ssl' or '$(ProjectName)' == '_hashlib'">$(opensslOutDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- Static libcrypto on Windows requires Windows socket, crypto, and security libraries -->
      <AdditionalDependencies Condition="'$(ProjectName)' == '_ssl' or '$(ProjectName)' == '_hashlib'">ws2_32.lib;crypt32.lib;advapi32.lib;user32.lib;libcrypto.lib;libssl.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
